# Copy this file to .env and fill in real values for local development.
# Never commit the real .env file.

# --- Database ---
POSTGRES_USER=mindmap
POSTGRES_PASSWORD=mindmap_dev_password
POSTGRES_DB=mindmap
DATABASE_URL=postgresql+asyncpg://mindmap:mindmap_dev_password@postgres:5432/mindmap

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- JWT ---
# Generate a real secret with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=replace-this-with-a-long-random-string
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
